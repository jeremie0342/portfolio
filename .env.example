DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flemart?schema=public"

# Absolute origin. Canonical URLs, language alternates, the sitemap and the
# share images are all built from it, so in production it must be the real
# domain and nothing else.
NEXT_PUBLIC_SITE_URL="https://zardonis.skill-uv.com"

# Optional. With a key set, a write from the console announces the addresses it
# changed to the engines that implement IndexNow, which is Bing and the
# assistants that search through it. The key is public by design: it is served
# at /indexnow.txt so an engine can check the announcement came from this host.
# Any 8 to 128 hexadecimal characters will do.
INDEXNOW_KEY=""

# Optional, and only needed if Search Console is verified by meta tag rather
# than by a DNS record. A record covers every subdomain and cannot be lost to a
# forgotten variable, so it is the better answer where the zone is reachable.
GOOGLE_SITE_VERIFICATION=""

# Optional. Contribution totals live on the GraphQL API, which requires a
# token; without one the figures fall back to the values recorded in
# src/lib/evidence.ts. A read-only token with no scopes is enough.
GITHUB_TOKEN=""

# ---------------------------------------------------------------------------
# Console
#
# Run `npm run console:secrets` to generate the three values below. The path is
# not a security boundary, it only keeps scanners away from the login form; the
# password and the signing secret are what actually hold the door.
# ---------------------------------------------------------------------------
CONSOLE_PATH=""
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""

# Optional. Without these the console still reads, files and records replies,
# and the reply is sent by hand from any mail client. The sending address has
# to be on a domain verified with Resend.
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""

# Optional. Without these the console shows the media section and refuses
# uploads rather than writing a row that points at a file nobody wrote.
# MINIO_PUBLIC_URL is the origin a browser fetches objects from, which is not
# always the one the server writes to.
MINIO_ENDPOINT=""
MINIO_PORT=""
MINIO_USE_SSL="true"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET=""
MINIO_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Server only
#
# Not used locally. These belong in the environment of the deployment, and
# docs/deployment.md is the order to set them in.
# ---------------------------------------------------------------------------
# POSTGRES_USER=""
# POSTGRES_PASSWORD=""
# POSTGRES_DB=""
# MINIO_ROOT_USER=""
# MINIO_ROOT_PASSWORD=""
